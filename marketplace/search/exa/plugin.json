{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
    "name": "exa",
    "description": "Pages, lists, and partner data — Similarweb traffic, companies, and people",
    "author": {
        "name": "Exa",
        "url": "https://exa.ai"
    },
    "homepage": "https://exa.ai/docs/reference/exa-mcp",
    "keywords": [
        "similarweb",
        "fiber",
        "baselayer",
        "jinko",
        "companies",
        "people",
        "traffic"
    ],
    "extensions": {
        "reforma": {
            "logo": "assets/logo.svg",
            "mcpServers": "./mcp.json",
            "interface": {
                "displayName": "Exa",
                "brandColor": "#FFFFFF",
                "logo": "assets/logo.svg",
                "logoSmall": "assets/logo-small.svg"
            },
            "logoSmall": "assets/logo-small.svg",
            "agent": {
                "mentions": [
                    "exa.ai",
                    "similarweb",
                    "similarweb.com",
                    "baselayer",
                    "jinko"
                ]
            }
        }
    }
}
