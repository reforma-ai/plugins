{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
    "name": "shadcn",
    "description": "Find shadcn/ui components and examples in the registries this project already uses",
    "author": {
        "name": "shadcn",
        "url": "https://ui.shadcn.com"
    },
    "homepage": "https://ui.shadcn.com",
    "repository": "https://github.com/shadcn-ui/ui",
    "license": "MIT",
    "extensions": {
        "reforma": {
            "default": true,
            "logo": "assets/logo.svg",
            "logoSmall": "assets/logo-small.svg",
            "interface": {
                "displayName": "shadcn",
                "brandColor": "#000000",
                "logoSmall": "assets/logo-small.svg"
            },
            "agent": {
                "installApproval": false,
                "mentions": [
                    "ui.shadcn.com"
                ]
            }
        }
    }
}
